            "annotatedSource": "def import_handoff(upload): # TAINT: upload is attacker-supplied UploadedFile from request.FILES['bundle'] at portal/views.py:79-80 PRECOND: caller checks only that a file was uploaded; there is no repo-visible authentication, signature, or content validation before deserialization HIST: file ranking flags this function as the repository's highest-risk CWE-502 sink\n    rows = pickle.loads(upload.read()) # DATA-FLOW: upload.read() loads the entire client file into memory, so bundle size is attacker-controlled and can cause memory pressure TAINT: pickle.loads deserializes attacker-controlled bytes and can execute arbitrary code during object reconstruction ERRPATH: malformed pickles raise immediately and portal/views.py:77-82 does not catch the exception, returning 500\n    created = []\n    for row in rows: # INV: at loop entry, created contains every Ticket successfully inserted so far; because no transaction.atomic exists in the repo, later failures leave those earlier inserts committed DATA-FLOW: each row object is fully attacker-controlled output from pickle; the code assumes it behaves like a dict\n        subject = row.get(\"subject\", \"Delivery follow-up\") # DATA-FLOW: subject comes from row.get() on untrusted data with no type or schema validation\n        description = row.get(\"description\", \"\") # DATA-FLOW: description is likewise untrusted and unvalidated before later classification and storage\n        ticket = Ticket.objects.create( # OWNERSHIP: Ticket.objects.create returns a saved Ticket model instance; under Django autocommit the row is durable before the next loop iteration ERRPATH: any exception after this insert leaves a partially imported ticket set because there is no rollback or cleanup path\n            reference=row.get(\"reference\") or slugify(subject)[:18], # TAINT: reference is attacker-controlled when supplied; only the fallback slugify(subject)[:18] is length-constrained CONSTRAINT: Ticket.reference is unique and max_length=24 in portal/models.py:9, so explicit untrusted references can trigger IntegrityError or DataError and abort mid-import\n            customer_key=row.get(\"customer_key\", \"walkup\"), # TAINT: customer_key is attacker-controlled, allowing bundle authors to place imported tickets into arbitrary customer buckets; default is literal 'walkup'\n            customer_name=row.get(\"customer_name\", \"Caldova customer\"), # TAINT: customer_name is attacker-controlled and stored directly in Ticket.customer_name\n            delivery_address=row.get(\"delivery_address\", \"Unknown route\"), # TAINT: delivery_address is attacker-controlled and stored directly in Ticket.delivery_address\n            robot_unit=row.get(\"robot_unit\", \"RB-000\"), # TAINT: robot_unit is attacker-controlled and stored directly in Ticket.robot_unit\n            subject=subject, # TAINT: subject is attacker-controlled and stored directly in Ticket.subject\n            description=description, # TAINT: description is attacker-controlled and stored directly in Ticket.description\n            priority=priority_for(subject, description), # DATA-FLOW: priority is derived from untrusted subject and description by priority_for() in portal/workflow.py:25-31 via simple substring matching PRECOND: of priority_for's two callers, portal/views.py:31 passes form-cleaned strings but this caller does not validate unpickled values are str-like before the callee calls .lower()\n        )\n        created.append(ticket) # INV: created.append(ticket) keeps the return list aligned with the subset of rows already committed to the database\n    return created # DATA-FLOW: caller receives live Ticket model instances for every successful insert; on any earlier exception there is no all-or-nothing import guarantee",
