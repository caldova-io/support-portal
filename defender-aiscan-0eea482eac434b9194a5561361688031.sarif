            "ai/exploitability": "theoretical",
            "aiGenerated": true,
            "annotatedSource": "def new_ticket(request): # TAINT: request is untrusted HTTP input for a state-changing endpoint PRECOND: portal/urls.py:8 exposes this handler directly and no caller-side authentication or tenant binding is enforced before ticket creation HIST: portal/views.py is ranked a primary request boundary with CWE-20 and CWE-862 risk\n    if request.method == \"POST\": # DATA-FLOW: the POST branch is the only gate before creating a persistent Ticket record; no secondary authorization check occurs\n        form = TicketForm(request.POST) # TAINT: request.POST is attacker-controlled input to TicketForm CONSTRAINT: TicketForm only enforces customer_key<=64, customer_name<=120, delivery_address<=240, robot_unit<=32, subject<=180; description has no max_length in forms.py:4-10 PRECOND: form construction does not bind customer_key to current_customer() or any authenticated principal\n        if form.is_valid(): # PRECOND: form.is_valid() narrows values to strings within form constraints but does not prove the submitted customer_key belongs to the requester\n            data = form.cleaned_data # TAINT: cleaned_data remains user-controlled content after Django normalization\n            ticket = Ticket.objects.create( # DATA-FLOW: a persistent Ticket model is created directly from tainted form fields\n                reference=f\"RB-{Ticket.objects.count() + 1001}\", # DATA-FLOW: reference is derived from global Ticket.objects.count(), making it predictable and leaking approximate row count ERRPATH: count()+1001 is non-atomic; Ticket.reference is unique in models.py:9, so concurrent requests can collide and raise an unhandled IntegrityError\n                customer_key=data[\"customer_key\"], # TAINT: customer_key comes straight from client input PRECOND: violated: nothing enforces that this tenant identifier matches the requester, so tickets can be created under arbitrary customer_key values\n                customer_name=data[\"customer_name\"], # TAINT: customer_name is stored verbatim from user input\n                delivery_address=data[\"delivery_address\"], # TAINT: delivery_address is stored verbatim from user input\n                robot_unit=data[\"robot_unit\"], # TAINT: robot_unit is stored verbatim from user input\n                subject=data[\"subject\"], # TAINT: subject is stored verbatim from user input and also influences priority selection below\n                description=data[\"description\"], # TAINT: description is stored verbatim from user input; the form leaves this field effectively unbounded\n                priority=priority_for(data[\"subject\"], data[\"description\"]), # DATA-FLOW: subject and description drive workflow.priority_for(); workflow.py:25-31 promotes keywords like stuck/missing/blocked/refund to high and late/cold/spill to urgent, so a requester can self-escalate queue priority\n            )\n            return redirect(\"portal:ticket_detail\", ticket_id=ticket.id)\n    else:\n        form = TicketForm(initial={\"customer_key\": current_customer(request)}) # DATA-FLOW: on GET, current_customer() at views.py:10 seeds initial customer_key from an unsigned cookie or hard-coded default \"cst-north-loop\", so the form can be prefilled with another tenant and later submitted unchanged\n    return render(request, \"portal/new_ticket.html\", {\"form\": form})",
